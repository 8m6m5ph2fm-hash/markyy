for i,tn in ipairs(themeNames) do
    local th=Themes[tn]
    local trow=fr(misc,C.bg2,UDim2.new(0,0,0,0),UDim2.new(1,0,0,46),1) trow.LayoutOrder=i+1 crn(trow,14) sk(trow,C.bg3,1.2) gr(trow,C.bg3,C.bg1,150)
    local dO=fr(trow,th.p,UDim2.new(0,12,.5,-13),UDim2.new(0,26,0,26)) crn(dO,50) dO.BackgroundTransparency=0.55 sk(dO,C.t1,1,.70)
    local dI=fr(trow,th.p,UDim2.new(0,16,.5,-8),UDim2.new(0,16,0,16)) crn(dI,50) gg(dI,th.g1,th.g2,135)
    lb(trow,tn,UDim2.new(0,46,0,0),UDim2.new(.40,0,1,0),Enum.Font.GothamBold,13,C.t2,2)
    local aInd=lb(trow,i==1 and "◆ Active" or "",UDim2.new(.46,0,0,0),UDim2.new(.22,0,1,0),Enum.Font.Gotham,9,th.p,2)
    activeThemeInd[tn]=aInd
    local abF=fr(trow,th.p,UDim2.new(1,-88,.5,-17),UDim2.new(0,76,0,34),3) crn(abF,17) gg(abF,th.g1,th.g2,140)
    fr(abF,C.t1,UDim2.new(0,6,0,4),UDim2.new(.46,0,0,2),4).BackgroundTransparency=0.85
    local aL=lb(abF,"Apply",UDim2.new(0,0,0,0),UDim2.new(1,0,1,0),Enum.Font.GothamBold,12,C.bg0,4,Enum.TextXAlignment.Center)
    local aOb=Instance.new("TextButton") aOb.BackgroundTransparency=1 aOb.Size=UDim2.new(1,0,1,0) aOb.Text="" aOb.ZIndex=5 aOb.Parent=abF
    local cap=tn
    aOb.MouseButton1Click:Connect(function() CT=Themes[cap] isRainbow=(cap=="Rainbow") local cs=ColorSequence.new{ColorSequenceKeypoint.new(0,CT.g1),ColorSequenceKeypoint.new(1,CT.g2)} for _,g in ipairs(GRS) do g.Color=cs end HstK.Color=CT.p hubNeon.BackgroundColor3=CT.p for _,ind in pairs(activeThemeInd) do ind.Text="" end activeThemeInd[cap].Text="◆ Active" activeThemeInd[cap].TextColor3=CT.p aL.Text="✓" task.delay(1.5,function() if aL and aL.Parent then aL.Text="Apply" end end) end)
    trow.MouseEnter:Connect(function() tw(trow,{BackgroundColor3=C.bg4},.12) end) trow.MouseLeave:Connect(function() tw(trow,{BackgroundColor3=C.bg2},.12) end)
end
task.defer(function() if pageLLs["More"] then misc.CanvasSize=UDim2.new(0,0,0,pageLLs["More"].AbsoluteContentSize.Y+24) end end)

-- ══════════════════════════════════════════════════════════
--  SEQUENCES
-- ══════════════════════════════════════════════════════════
local function showHub()
    tierL.Text="👑" tierStk.Color=C.g1 tierStk.Transparency=0.16
    HUB.Visible=true HUB.Size=UDim2.new(0,0,0,0)
    tw(HUB,{Size=UDim2.new(0,594,0,468)},.52,Enum.EasingStyle.Back,Enum.EasingDirection.Out)
    switchTab("Trade") end

local function doVerify(key)
    local ok=(key==KEY)
    KS.Visible=false VB.Visible=true vProg.Size=UDim2.new(0,0,1,0)
    local steps=ok and {"Connecting to auth server...","TLS 1.3 handshake complete.","Scanning key registry...","Key found — OWNER  ◆","License active.","Welcome back, Owner!"}
    or {"Connecting to auth server...","TLS 1.3 handshake complete.","Scanning key registry...","Key not found.","Access denied.","Session closed."}
    for i,s in ipairs(steps) do task.wait(.30) vSub.Text=s tw(vProg,{Size=UDim2.new(i/#steps,0,1,0)},.24) end
    task.wait(.40)
    if ok then VB.Visible=false showHub()
    else tw(VB,{BackgroundTransparency=1},.22) task.wait(.25) VB.BackgroundTransparency=0 VB.Visible=false KS.Visible=true KErr.Text="✗  Invalid key — access denied." kInStk.Color=C.err kInStk.Thickness=2 isUpd=true rKey="" KInput.Text="" task.defer(function() isUpd=false end) for _=1,4 do tw(kR,{Position=UDim2.new(.5,-262,.5,-192)},.04) task.wait(.05) tw(kR,{Position=UDim2.new(.5,38,.5,-192)},.04) task.wait(.05) end task.wait(2.2) KErr.Text="" kInStk.Color=C.bg4 kInStk.Thickness=1.8 end end

local submitting=false
KBtn.MouseButton1Click:Connect(function() if submitting then return end submitting=true local k=rKey:gsub("%s+","") task.spawn(function() doVerify(k) submitting=false end) end)

-- ══════════════════════════════════════════════════════════
--  SINGLE RUNTIME LOOP
-- ══════════════════════════════════════════════════════════
local fpsBuf={} local fpsS=60 local pingS=38
RunService.Heartbeat:Connect(function(dt)
    table.insert(fpsBuf,dt) if #fpsBuf>30 then table.remove(fpsBuf,1) end
    local avg=0 for _,v in ipairs(fpsBuf) do avg=avg+v end avg=avg/#fpsBuf
    fpsS=fpsS+(math.floor(1/avg)-fpsS)*.08
    local fd=math.clamp(math.floor(fpsS),1,999)
    local fC=fd>=55 and C.ok or fd>=30 and C.wrn or C.err
    local op,rp=pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    local tg=op and rp and rp>0 and rp or (pingS+math.random(-4,6))
    pingS=pingS+(tg-pingS)*.06
    local pd=math.max(1,math.floor(pingS))
    local pC=pd<=60 and C.ok or pd<=120 and C.wrn or C.err

    -- floating bar always
    wFps.Text="FPS: "..fd   wFps.TextColor3=fC
    wPing.Text="PING: "..pd.."ms" wPing.TextColor3=pC
    -- logo shimmer
    wLTxt.TextColor3=Color3.fromHSV((tick()*.08)%1,.72,1)

    if HUB.Visible then
        -- ONLY ping in header (no FPS chip)
        pingTL.Text="PING "..pd pingTL.TextColor3=pC pingDot.BackgroundColor3=pC
        -- stats tab
        if fpsVal  then fpsVal.Text=tostring(fd)  fpsVal.TextColor3=fC end
        if pingVal then pingVal.Text=pd.." ms"    pingVal.TextColor3=pC end
        if fpsBar  then tw(fpsBar, {Size=UDim2.new(math.clamp(fd/144,0,1),0,1,0)},.45) end
        if pingBar then tw(pingBar,{Size=UDim2.new(math.clamp(1-pd/260,0,1),0,1,0)},.45) end
        if isRainbow then
            rHue=(rHue+dt*.08)%1
            local rc=Color3.fromHSV(rHue,.85,1) local rc2=Color3.fromHSV((rHue+.5)%1,.85,1)
            for _,g in ipairs(GRS) do g.Color=ColorSequence.new{ColorSequenceKeypoint.new(0,rc),ColorSequenceKeypoint.new(1,rc2)} end
            HstK.Color=rc hubNeon.BackgroundColor3=rc end end

    local t=(tick()*.12)%1
    for _,r in ipairs({csI1,csI2,csI3,csT1,csT2,csT3}) do if r and r.Parent then r.TextColor3=Color3.fromHSV(t,.82,1) end end end)

-- ══════════════════════════════════════════════════════════
--  LAUNCH
-- ══════════════════════════════════════════════════════════
task.spawn(function()
    for i,s in ipairs(BOOT_LOG) do
        task.wait(.20) bStat.Text=s
        local pct=i/#BOOT_LOG
        tw(bProg,{Size=UDim2.new(pct,0,1,0)},.16)
        bPct.Text=math.floor(pct*100).."%" end
    task.wait(.32)
    tw(Boot,{BackgroundTransparency=1},.28) task.wait(.30)
    Boot.Visible=false Boot.BackgroundTransparency=0
    KS.Visible=true
    tw(kL,{Position=UDim2.new(.5,-286,.5,-192)},.48,Enum.EasingStyle.Back,Enum.EasingDirection.Out)
    tw(kR,{Position=UDim2.new(.5,38,.5,-192)},.48,Enum.EasingStyle.Back,Enum.EasingDirection.Out)
end)

