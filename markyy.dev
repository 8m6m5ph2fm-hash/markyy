vChLL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() vChF.Size=UDim2.new(1,0,0,vChLL.AbsoluteContentSize.Y+4) end)
local function validateText(text)
    for _,c in ipairs(vChF:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    if text=="" then vResI.Text="" vResM.Text="Ketik kata di atas untuk cek validity" vResM.TextColor3=C.t3 vResS.Text="" vRes.BackgroundTransparency=0.35 sk(vRes,C.bg4,1.5) return end
    local words={} for w in text:lower():gmatch("%S+") do table.insert(words,w) end if #words==0 then return end
    local validCount=0 local inv={}
    for i,word in ipairs(words) do
        local isV=BRAINROT_DB[word]==true if isV then validCount=validCount+1 else table.insert(inv,word) end
        local chip=fr(vChF,C.bg0,UDim2.new(0,0,0,0),UDim2.new(0,0,0,26),1) chip.LayoutOrder=i crn(chip,13)
        local cLL=Instance.new("UIListLayout") cLL.FillDirection=Enum.FillDirection.Horizontal cLL.Padding=UDim.new(0,4) cLL.VerticalAlignment=Enum.VerticalAlignment.Center cLL.Parent=chip
        local cP=Instance.new("UIPadding") cP.PaddingLeft=UDim.new(0,8) cP.PaddingRight=UDim.new(0,8) cP.Parent=chip
        local cs=Instance.new("UISizeConstraint") cs.MaxSize=Vector2.new(math.huge,26) cs.Parent=chip
        cLL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() chip.Size=UDim2.new(0,cLL.AbsoluteContentSize.X+16,0,26) end)
        if isV then chip.BackgroundColor3=Color3.fromRGB(0,34,18) sk(chip,C.ok,1,.40) lb(chip,"✓",UDim2.new(0,0,0,0),UDim2.new(0,14,1,0),Enum.Font.GothamBold,10,C.ok,2,Enum.TextXAlignment.Center) lb(chip,word,UDim2.new(0,0,0,0),UDim2.new(0,#word*7+8,1,0),Enum.Font.GothamBold,10,C.ok,2)
        else chip.BackgroundColor3=Color3.fromRGB(40,4,8) sk(chip,C.err,1,.40) lb(chip,"✗",UDim2.new(0,0,0,0),UDim2.new(0,14,1,0),Enum.Font.GothamBold,10,C.err,2,Enum.TextXAlignment.Center) lb(chip,word,UDim2.new(0,0,0,0),UDim2.new(0,#word*7+8,1,0),Enum.Font.GothamBold,10,C.err,2) end end
    if #inv==0 then vResI.Text="✓" vResI.TextColor3=C.ok vResM.Text="VALID  —  "..#words.." kata diterima" vResM.TextColor3=C.ok vResS.Text="Semua kata ada di database ◆" vResS.TextColor3=Color3.fromRGB(40,176,96) vRes.BackgroundColor3=Color3.fromRGB(0,24,12) vRes.BackgroundTransparency=0.16 local rs=vRes:FindFirstChildOfClass("UIStroke") if rs then rs.Color=C.ok end
    else vResI.Text="✗" vResI.TextColor3=C.err vResM.Text="INVALID  —  "..#inv.." kata tidak dikenal" vResM.TextColor3=C.err vResS.Text="Tidak valid: "..table.concat(inv,", ") vResS.TextColor3=Color3.fromRGB(255,115,130) vRes.BackgroundColor3=Color3.fromRGB(36,3,7) vRes.BackgroundTransparency=0.16 local rs=vRes:FindFirstChildOfClass("UIStroke") if rs then rs.Color=C.err end end end
vInput:GetPropertyChangedSignal("Text"):Connect(function() validateText(vInput.Text) end)

