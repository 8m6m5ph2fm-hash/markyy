local rKey="" local isUpd=false
KInput:GetPropertyChangedSignal("Text"):Connect(function()
    if isUpd then return end isUpd=true
    local cur=KInput.Text local cl=#cur local rl=#rKey
    if cl>rl then rKey=rKey..cur:sub(rl+1):gsub("●","") elseif cl<rl then rKey=rKey:sub(1,#rKey-(rl-cl)) end
    rKey=rKey:lower() KInput.Text=string.rep("●",#rKey) task.defer(function() isUpd=false end) end)
