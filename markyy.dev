local TabOuter=fr(HUB,C.bg0,UDim2.new(0,0,0,62),UDim2.new(1,0,0,46),2) TabOuter.BackgroundTransparency=0.44 sk(TabOuter,C.bg3,1)
fr(TabOuter,C.t1,UDim2.new(0,0,1,-1),UDim2.new(1,0,0,1),3).BackgroundTransparency=0.88
local TabNav=Instance.new("ScrollingFrame") TabNav.BackgroundTransparency=1 TabNav.Size=UDim2.new(1,0,1,0) TabNav.BorderSizePixel=0 TabNav.ScrollBarThickness=0 TabNav.ScrollingDirection=Enum.ScrollingDirection.X TabNav.CanvasSize=UDim2.new(0,0,1,0) TabNav.Parent=TabOuter
local tabLL=Instance.new("UIListLayout") tabLL.FillDirection=Enum.FillDirection.Horizontal tabLL.SortOrder=Enum.SortOrder.LayoutOrder tabLL.Padding=UDim.new(0,4) tabLL.VerticalAlignment=Enum.VerticalAlignment.Center tabLL.HorizontalAlignment=Enum.HorizontalAlignment.Center tabLL.Parent=TabNav
local tabP=Instance.new("UIPadding") tabP.PaddingLeft=UDim.new(0,6) tabP.PaddingRight=UDim.new(0,6) tabP.Parent=TabNav
tabLL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() TabNav.CanvasSize=UDim2.new(0,tabLL.AbsoluteContentSize.X+12,1,0) end)

local Content=fr(HUB,C.bg0,UDim2.new(0,0,0,108),UDim2.new(1,0,1,-32),2) Content.BackgroundTransparency=0.50
local SBar=fr(HUB,C.bg0,UDim2.new(0,0,1,-32),UDim2.new(1,0,0,32),2) SBar.BackgroundTransparency=0.44 sk(SBar,C.bg3,1)
lb(SBar,"◆  "..NAME.."  ·  "..VER.."  ·  Phantom Elite  ·  by "..BY,UDim2.new(0,0,0,0),UDim2.new(1,0,1,0),Enum.Font.GothamBold,8,C.t5,3,Enum.TextXAlignment.Center)

-- ══ TAB SYSTEM ══
local Pages={} local TabBtns={} local pageLLs={} local activeP=nil
local function switchTab(name)
    if mini then mini=false tw(HUB,{Size=UDim2.new(0,594,0,468)},.28) MinB.Text="–" end
    for n,pg in pairs(Pages) do pg.Visible=(n==name) end
    for n,btn in pairs(TabBtns) do local on=(n==name) tw(btn,{BackgroundColor3=on and CT.p or C.bg2,BackgroundTransparency=on and 0 or 0.65},.18) local tl=btn:FindFirstChildOfClass("TextLabel") if tl then tw(tl,{TextColor3=on and C.t1 or C.t4},.18) end end
    if Pages[name] and pageLLs[name] then Pages[name].CanvasSize=UDim2.new(0,0,0,pageLLs[name].AbsoluteContentSize.Y+24) end
    activeP=name end

local function mkTab(name,icon,order)
    local btn=fr(TabNav,C.bg2,UDim2.new(0,0,0,0),UDim2.new(0,82,0,32),3) btn.BackgroundTransparency=0.65 crn(btn,16) btn.LayoutOrder=order
    lb(btn,icon.." "..name,UDim2.new(0,0,0,0),UDim2.new(1,0,1,0),Enum.Font.GothamBold,9,C.t4,4,Enum.TextXAlignment.Center)
    local ob=Instance.new("TextButton") ob.BackgroundTransparency=1 ob.Size=UDim2.new(1,0,1,0) ob.Text="" ob.ZIndex=5 ob.Parent=btn
    ob.MouseEnter:Connect(function() if activeP~=name then tw(btn,{BackgroundTransparency=0.44},.12) end end)
    ob.MouseLeave:Connect(function() if activeP~=name then tw(btn,{BackgroundTransparency=0.65},.12) end end)
    ob.MouseButton1Click:Connect(function() switchTab(name) end)
    local pg=Instance.new("ScrollingFrame") pg.BackgroundTransparency=1 pg.Size=UDim2.new(1,0,1,0) pg.BorderSizePixel=0 pg.ScrollBarThickness=2 pg.ScrollBarImageColor3=C.v3 pg.ScrollBarImageTransparency=0.44 pg.CanvasSize=UDim2.new(0,0,0,0) pg.Visible=false pg.Parent=Content
    local pll=Instance.new("UIListLayout") pll.SortOrder=Enum.SortOrder.LayoutOrder pll.Padding=UDim.new(0,6) pll.Parent=pg
    local pad=Instance.new("UIPadding") pad.PaddingTop=UDim.new(0,10) pad.PaddingLeft=UDim.new(0,11) pad.PaddingRight=UDim.new(0,11) pad.Parent=pg
    pll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() pg.CanvasSize=UDim2.new(0,0,0,pll.AbsoluteContentSize.Y+24) end)
    Pages[name]=pg TabBtns[name]=btn pageLLs[name]=pll return pg end

-- ══ WIDGETS ══
local function mkSec(par,title,order)
    local w=fr(par,C.bg0,UDim2.new(0,0,0,0),UDim2.new(1,0,0,28),1) w.BackgroundTransparency=1 w.LayoutOrder=order or 0
    lb(w,"◆",UDim2.new(0,0,.5,-8),UDim2.new(0,14,0,16),Enum.Font.GothamBold,7,C.g1,2,Enum.TextXAlignment.Center)
    fr(w,C.v2,UDim2.new(0,14,.5,-1),UDim2.new(0,10,0,1),2).BackgroundTransparency=0.52
    lb(w,string.upper(title),UDim2.new(0,26,0,0),UDim2.new(1,-28,1,0),Enum.Font.GothamBold,8,C.v3,2)
    fr(w,C.bg4,UDim2.new(0,26,.5,-1),UDim2.new(1,-28,0,1),1).BackgroundTransparency=0.55
    return w end

local function mkToggle(par,name,order,defOn,badge)
    local row=fr(par,C.bg2,UDim2.new(0,0,0,0),UDim2.new(1,0,0,50),1) row.LayoutOrder=order or 0 crn(row,14) sk(row,C.bg3,1.2) gr(row,C.bg3,C.bg1,150)
    -- shimmer line top
    local sTop=fr(row,C.t1,UDim2.new(0,0,0,0),UDim2.new(1,0,0,1),2) sTop.BackgroundTransparency=0.94
    local strip=fr(row,CT.p,UDim2.new(0,0,.12,0),UDim2.new(0,3,.76,0),2) crn(strip,2) strip.BackgroundTransparency=defOn and 0.04 or 0.92
    lb(row,name,UDim2.new(0,15,0,0),UDim2.new(.54,0,1,0),Enum.Font.Gotham,12,C.t2,2)
    if badge then local bf=fr(row,C.wrn,UDim2.new(.55,8,.5,-11),UDim2.new(0,80,0,22),3) crn(bf,11) gg(bf,Color3.fromRGB(255,196,0),Color3.fromRGB(202,135,0),135) lb(bf,badge,UDim2.new(0,0,0,0),UDim2.new(1,0,1,0),Enum.Font.GothamBold,8,C.bg0,4,Enum.TextXAlignment.Center) end
    local track=fr(row,defOn and CT.p or Color3.fromRGB(11,7,19),UDim2.new(1,-70,.5,-14),UDim2.new(0,54,0,28),2) crn(track,50)
    local tS=sk(track,defOn and CT.a or Color3.fromRGB(20,10,40),1,defOn and 0.38 or 0)
    if defOn then gr(track,CT.a,CT.p,140) end
    local knob=fr(track,C.t1,defOn and UDim2.new(1,-23,.5,-12) or UDim2.new(0,3,.5,-12),UDim2.new(0,24,0,24),3) crn(knob,50) sk(knob,C.t2,1,.65)
    local tog=defOn or false
    local ob=Instance.new("TextButton") ob.BackgroundTransparency=1 ob.Size=UDim2.new(1,0,1,0) ob.Text="" ob.ZIndex=4 ob.Parent=row
    ob.MouseButton1Click:Connect(function() tog=not tog tw(track,{BackgroundColor3=tog and CT.p or Color3.fromRGB(11,7,19)}) tw(knob,{Position=tog and UDim2.new(1,-23,.5,-12) or UDim2.new(0,3,.5,-12)}) tw(strip,{BackgroundTransparency=tog and 0.04 or 0.92}) tS.Color=tog and CT.a or Color3.fromRGB(20,10,40) tS.Transparency=tog and 0.38 or 0 end)
    row.MouseEnter:Connect(function() tw(row,{BackgroundColor3=C.bg4},.12) end) row.MouseLeave:Connect(function() tw(row,{BackgroundColor3=C.bg2},.12) end)
    return row,function() return tog end end

local function mkVisRow(par,lo,name)
    local row=fr(par,C.bg2,UDim2.new(0,0,0,0),UDim2.new(1,0,0,50),1) row.LayoutOrder=lo crn(row,14) sk(row,C.bg3,1.2) gr(row,C.bg3,C.bg1,150)
    fr(row,C.t1,UDim2.new(0,0,0,0),UDim2.new(1,0,0,1),2).BackgroundTransparency=0.94
    local strip=fr(row,CT.p,UDim2.new(0,0,.12,0),UDim2.new(0,3,.76,0),2) crn(strip,2) strip.BackgroundTransparency=0.92
    lb(row,name,UDim2.new(0,15,0,0),UDim2.new(.54,0,1,0),Enum.Font.Gotham,12,C.t2,2)
    local track=fr(row,Color3.fromRGB(11,7,19),UDim2.new(1,-70,.5,-14),UDim2.new(0,54,0,28),2) crn(track,50) local tS=sk(track,Color3.fromRGB(20,10,40),1,0)
    local knob=fr(track,C.t1,UDim2.new(0,3,.5,-12),UDim2.new(0,24,0,24),3) crn(knob,50) sk(knob,C.t2,1,.65)
    local ob=Instance.new("TextButton") ob.BackgroundTransparency=1 ob.Size=UDim2.new(1,0,1,0) ob.Text="" ob.ZIndex=5 ob.Parent=row
    row.MouseEnter:Connect(function() tw(row,{BackgroundColor3=C.bg4},.12) end) row.MouseLeave:Connect(function() tw(row,{BackgroundColor3=C.bg2},.12) end)
    return ob,track,knob,strip,tS end

local function mkSlider(par,name,minV,maxV,defV,order)
    local row=fr(par,C.bg2,UDim2.new(0,0,0,0),UDim2.new(1,0,0,62),1) row.LayoutOrder=order or 0 crn(row,14) sk(row,C.bg3,1.2) gr(row,C.bg3,C.bg1,150)
    fr(row,CT.p,UDim2.new(0,0,.12,0),UDim2.new(0,3,.76,0),2).BackgroundTransparency=0.92
    lb(row,name,UDim2.new(0,15,0,9),UDim2.new(.55,0,0,18),Enum.Font.Gotham,11,C.t2,2)
    local vL=lb(row,tostring(defV),UDim2.new(.55,0,0,9),UDim2.new(.40,0,0,18),Enum.Font.GothamBold,12,C.v3,2,Enum.TextXAlignment.Right)
    local tBg=fr(row,C.bg0,UDim2.new(0,15,0,36),UDim2.new(1,-30,0,8),2) crn(tBg,4) sk(tBg,C.bg4,1)
    local fill=fr(tBg,CT.p,UDim2.new(0,0,0,0),UDim2.new((defV-minV)/(maxV-minV),0,1,0),3) crn(fill,4) gr(fill,CT.a,CT.p,0)
    local knob=fr(tBg,C.t1,UDim2.new((defV-minV)/(maxV-minV),0,.5,0),UDim2.new(0,18,0,18),4) knob.AnchorPoint=Vector2.new(.5,.5) crn(knob,50) sk(knob,C.v3,1.5,.26)
    local drag=false
    local tB=Instance.new("TextButton") tB.BackgroundTransparency=1 tB.Size=UDim2.new(1,0,3,-4) tB.Position=UDim2.new(0,0,.5,-10) tB.Text="" tB.ZIndex=5 tB.Parent=tBg
    local function upd(x) local f2=math.clamp((x-tBg.AbsolutePosition.X)/tBg.AbsoluteSize.X,0,1) vL.Text=tostring(math.floor(minV+f2*(maxV-minV))) tw(fill,{Size=UDim2.new(f2,0,1,0)},.07) tw(knob,{Position=UDim2.new(f2,0,.5,0)},.07) end
    tB.MouseButton1Down:Connect(function() drag=true upd(UserInputService:GetMouseLocation().X) end)
    UserInputService.InputChanged:Connect(function(i) if drag and i.UserInputType==Enum.UserInputType.MouseMovement then upd(i.Position.X) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end)
    row.MouseEnter:Connect(function() tw(row,{BackgroundColor3=C.bg4},.12) end) row.MouseLeave:Connect(function() tw(row,{BackgroundColor3=C.bg2},.12) end)
    return row end

local function mkCS(par,main,sub,lo)
    local f=fr(par,C.bg2,UDim2.new(0,0,0,0),UDim2.new(1,0,0,210),1) f.LayoutOrder=lo or 1 crn(f,18) sk(f,C.bg3,1.5) gr(f,C.bg3,C.bg1,150)
    local cR=fr(f,CT.p,UDim2.new(.5,-44,.20,-44),UDim2.new(0,88,0,88),2) crn(cR,44) cR.BackgroundTransparency=0.87
    local cM=fr(f,CT.p,UDim2.new(.5,-34,.20,-34),UDim2.new(0,68,0,68),3) crn(cM,34) cM.BackgroundTransparency=0.81
    local cC=fr(f,C.bg0,UDim2.new(.5,-24,.20,-24),UDim2.new(0,48,0,48),4) crn(cC,24) gr(cC,C.bg3,C.bg0,145) sk(cC,CT.p,2,.38)
    local cI=lb(cC,"✦",UDim2.new(0,0,0,0),UDim2.new(1,0,1,0),Enum.Font.GothamBold,22,CT.a,5,Enum.TextXAlignment.Center)
    fr(f,CT.p,UDim2.new(.10,0,.58,0),UDim2.new(.80,0,0,1),3).BackgroundTransparency=0.68
    local l2=lb(f,main,UDim2.new(0,14,.66,0),UDim2.new(1,-28,0,28),Enum.Font.GothamBold,20,CT.a,3,Enum.TextXAlignment.Center) l2.AnchorPoint=Vector2.new(0,.5)
    local l3=lb(f,sub,UDim2.new(0,14,.83,0),UDim2.new(1,-28,0,30),Enum.Font.Gotham,10,C.t4,3,Enum.TextXAlignment.Center) l3.AnchorPoint=Vector2.new(0,.5) l3.TextWrapped=true
    return cI,l2 end

local function mkSCard(par,title,icon,vc,order)
    local c=fr(par,C.bg2,UDim2.new(0,0,0,0),UDim2.new(1,0,0,86),1) c.LayoutOrder=order crn(c,16) sk(c,C.bg3,1.2) gr(c,C.bg3,C.bg1,150)
    fr(c,vc,UDim2.new(0,0,.10,0),UDim2.new(0,3,.80,0),2).BackgroundTransparency=0.16
    local iB=fr(c,vc,UDim2.new(0,15,.5,-23),UDim2.new(0,46,0,46),2) crn(iB,23) iB.BackgroundTransparency=0.76
    lb(iB,icon,UDim2.new(0,0,0,0),UDim2.new(1,0,1,0),Enum.Font.GothamBold,22,vc,3,Enum.TextXAlignment.Center)
    lb(c,title,UDim2.new(0,68,0,14),UDim2.new(.58,0,0,13),Enum.Font.GothamBold,8,C.t4,3)
    local vL=lb(c,"—",UDim2.new(0,68,0,28),UDim2.new(.62,0,0,30),Enum.Font.GothamBold,26,vc,3)
    local bBg=fr(c,C.bg0,UDim2.new(0,15,1,-14),UDim2.new(1,-30,0,5),2) crn(bBg,3) sk(bBg,C.bg4,1)
    local bF=fr(bBg,vc,UDim2.new(0,0,0,0),UDim2.new(0,0,1,0),3) crn(bF,3)
    c.MouseEnter:Connect(function() tw(c,{BackgroundColor3=C.bg4},.12) end) c.MouseLeave:Connect(function() tw(c,{BackgroundColor3=C.bg2},.12) end)
    return vL,bF end

