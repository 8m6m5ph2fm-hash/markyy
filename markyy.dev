-- ══ UTILS ══
local function crn(p,r) local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,r or 8) c.Parent=p return c end
local function tw(o,pr,t,es,ed) TweenService:Create(o,TweenInfo.new(t or .22,es or Enum.EasingStyle.Quart,ed or Enum.EasingDirection.Out),pr):Play() end
local function fr(par,bg,pos,sz,z) local f=Instance.new("Frame") f.BackgroundColor3=bg or C.bg2 f.BorderSizePixel=0 f.Position=pos or UDim2.new(0,0,0,0) f.Size=sz or UDim2.new(1,0,1,0) f.ZIndex=z or 1 f.Parent=par return f end
local function lb(par,txt,pos,sz,font,ts,col,z,xa) local l=Instance.new("TextLabel") l.BackgroundTransparency=1 l.Position=pos l.Size=sz l.Font=font or Enum.Font.GothamBold l.Text=txt l.TextSize=ts or 12 l.TextColor3=col or C.t2 l.ZIndex=z or 1 l.TextXAlignment=xa or Enum.TextXAlignment.Left l.TextWrapped=true l.Parent=par return l end
local function gg(p,c1,c2,rot) local g=Instance.new("UIGradient") g.Color=ColorSequence.new{ColorSequenceKeypoint.new(0,c1),ColorSequenceKeypoint.new(1,c2)} g.Rotation=rot or 135 g.Parent=p return g end
local function sk(p,col,th,tr) local s=Instance.new("UIStroke") s.Color=col or CT.p s.Thickness=th or 1.5 if tr then s.Transparency=tr end s.Parent=p return s end
local function tb(par,txt,pos,sz,font,ts,col,z) local t=Instance.new("TextButton") t.BackgroundTransparency=1 t.Position=pos t.Size=sz t.Font=font or Enum.Font.GothamBold t.Text=txt t.TextSize=ts or 12 t.TextColor3=col or C.t2 t.ZIndex=z or 1 t.Parent=par return t end
local GRS={}
local function gr(p,c1,c2,rot) local g=gg(p,c1,c2,rot) table.insert(GRS,g) return g end
local function sh(p,tr,oy,sz) local s=Instance.new("ImageLabel") s.AnchorPoint=Vector2.new(.5,.5) s.BackgroundTransparency=1 s.Position=UDim2.new(.5,0,.5,oy or 16) s.Size=UDim2.new(1,sz or 56,1,sz or 56) s.ZIndex=(p.ZIndex or 1)-1 s.Image="rbxassetid://6014261993" s.ImageColor3=Color3.new(0,0,0) s.ImageTransparency=tr or .42 s.ScaleType=Enum.ScaleType.Slice s.SliceCenter=Rect.new(49,49,450,450) s.Parent=p return s end

