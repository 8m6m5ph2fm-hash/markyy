local pIF=fr(pp,C.bg2,UDim2.new(0,0,0,0),UDim2.new(1,0,0,36),1) pIF.LayoutOrder=2 crn(pIF,11) sk(pIF,C.v2,1,.50) gr(pIF,C.bg3,C.bg1,150) fr(pIF,C.v3,UDim2.new(0,0,.1,0),UDim2.new(0,3,.8,0),2).BackgroundTransparency=0.32
